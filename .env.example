# White-label client selection
# ------------------------------------------------------------------
# Exactly one client must be active per deployment. There is no default —
# the app fails fast with a clear error if this is missing or invalid.
# Valid values: voltix | apex | lumina (see src/config/clients/registry.ts)
VITE_STORE_ID=voltix

# Commerce integration (optional, only needed when a client's config sets
# commerce.provider to "woocommerce" or "rest")
# ------------------------------------------------------------------
# Never put secret values directly in this file. These variables hold the
# connection details for the *name* of the integration — the actual
# consumer key/secret should be provided by your hosting platform's
# secret manager at deploy time, not committed to the repo.
# VITE_WOOCOMMERCE_BASE_URL="https://example-store.com/wp-json/wc/v3"
# VITE_WOOCOMMERCE_CONSUMER_KEY_VAR="WC_CONSUMER_KEY"
# VITE_WOOCOMMERCE_CONSUMER_SECRET_VAR="WC_CONSUMER_SECRET"
