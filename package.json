{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:voltix": "vite --port=3000 --host=0.0.0.0 --mode voltix",
    "dev:apex": "vite --port=3000 --host=0.0.0.0 --mode apex",
    "dev:lumina": "vite --port=3000 --host=0.0.0.0 --mode lumina",
    "dev:shams": "vite --port=3000 --host=0.0.0.0 --mode shams",
    "build": "vite build",
    "build:voltix": "vite build --mode voltix",
    "build:apex": "vite build --mode apex",
    "build:lumina": "vite build --mode lumina",
    "build:shams": "vite build --mode shams",
    "verify:shams": "vite build --mode shams && node scripts/verify-client-build.mjs shams",
    "verify:voltix": "vite build --mode voltix && node scripts/verify-client-build.mjs voltix",
    "preview": "vite preview",
    "preview:shams": "vite preview --mode shams --port=3000",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "vite": "^6.2.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  }
}
